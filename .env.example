# ---------------------------------------------------------------------------
# Filing Intelligence Platform - environment template
# Copy to .env and fill in. .env is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- EDGAR ------------------------------------------------------------------
# REQUIRED. The SEC returns HTTP 403 on www.sec.gov without a descriptive
# User-Agent carrying a reachable contact address. Format: "Name email@domain".
# See https://www.sec.gov/os/webmaster-faq#developers
EDGAR_USER_AGENT=Your Name your.email@example.com

# Self-imposed ceiling. The SEC's published limit is 10 req/s; we stay under it.
EDGAR_RATE_LIMIT_PER_SEC=8.0

# --- LLM (needed from Day 4) ------------------------------------------------
# Provider is selected at runtime; set the key for whichever you use.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Object store (MinIO) ---------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=filings

# --- Postgres + pgvector ----------------------------------------------------
POSTGRES_DSN=postgresql://filing:filing@localhost:5432/filings

# --- MongoDB ----------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=filings

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Observability ----------------------------------------------------------
PROMETHEUS_PUSHGATEWAY=http://localhost:9091
LOG_LEVEL=INFO
