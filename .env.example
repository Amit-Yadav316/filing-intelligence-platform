# ---------------------------------------------------------------------------
# Filing Intelligence Platform - environment template
# Copy to .env and fill in. .env is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- EDGAR ------------------------------------------------------------------
# REQUIRED. The SEC returns HTTP 403 on www.sec.gov without a descriptive
# User-Agent carrying a reachable contact address. Format: "Name email@domain".
# See https://www.sec.gov/os/webmaster-faq#developers
EDGAR_USER_AGENT=Your Name your.email@example.com

# Self-imposed ceiling. The SEC's published limit is 10 req/s; we stay under it.
EDGAR_RATE_LIMIT_PER_SEC=8.0

# --- LLM (needed from Day 4) ------------------------------------------------
# Provider is selected at runtime; set the key for whichever you use.
# Provider selection. Any OpenAI-compatible provider works through one client;
# only the base URL, key and model differ.
#   gemini      structured output enforced by the provider
#   groq        fast, generous free tier, OpenAI-compatible
#   openrouter  many models behind one key, including free variants
#   cerebras / openai
LLM_PROVIDER=gemini
# Model name is provider-specific. Ask the provider what it serves rather
# than guessing: gemini-2.5-flash was retired for new API consumers and
# returns 404 with a pointer to its replacement.
LLM_MODEL=gemini-3.5-flash

# json_schema  provider enforces the schema (best, not universal)
# json_object  provider guarantees valid JSON; schema described in the prompt
LLM_STRUCTURED_MODE=json_object
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Object store (MinIO) ---------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=filings

# --- Postgres + pgvector ----------------------------------------------------
POSTGRES_DSN=postgresql://filing:filing@localhost:5432/filings

# --- MongoDB ----------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=filings

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Observability ----------------------------------------------------------
PROMETHEUS_PUSHGATEWAY=http://localhost:9091
LOG_LEVEL=INFO
