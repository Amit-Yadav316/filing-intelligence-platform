# Secrets
# .env.example IS committed - it is the template. The negation below keeps a
# broader .env* rule from swallowing it, which is the classic way a repo ends
# up with no usable template.
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key
*.p12
credentials.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Notebooks are not part of the deliverable
notebooks/

# Local model + data artefacts (data/sample/ is committed, see below)
models/
data/raw/
data/interim/
*.duckdb
*.sqlite

# Airflow local state
logs/
airflow.db
airflow.cfg
webserver_config.py
.astro/
airflow-webserver.pid
# Airflow standalone writes a generated admin password here. It is a real
# credential, not a config file.
standalone_admin_password.txt

# Local infrastructure state
# Bind-mounted volumes for the observability stack land here from day 6.
deploy/**/data/
docker-compose.override.yml
*.log

# Embedding and index artefacts, if ever dumped to disk rather than Postgres
*.pkl
*.npy
*.faiss

# Editors
.vscode/
.idea/
.vs/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Airflow lives in its own venv; its constraints conflict with the app stack.
.venv-airflow/
